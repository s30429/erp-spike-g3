{
  "name": "erp-spike",
  "image": "mcr.microsoft.com/devcontainers/python:3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": { "moby": false }
  },
  "hostRequirements": { "cpus": 4 },
  "postCreateCommand": "pip install httpx && docker compose up -d --build && docker compose run --rm api python -m app.seed",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": { "label": "Mini-ERP", "onAutoForward": "openBrowser" }
  }
}
